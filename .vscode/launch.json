{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Stock Tracker: App (Electron + Vite Live)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Stock Tracker: Renderer (Browser Live Preview)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src",
      "preLaunchTask": "dev:react (vite)"
    }
  ]
}
