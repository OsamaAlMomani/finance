{
  "name": "finance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/electron/main.js",
  "scripts": {
    "dev:react": "vite",
    "dev:electron": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "dev:electron:rebuild": "set ELECTRON_RUN_AS_NODE=&& npm run rebuild:electron && electron .",
    "dev": "concurrently -k \"npm:dev:react\" \"npm:dev:electron\"",
    "build": "tsc -b && vite build",
    "smoke:ipc": "npm run rebuild:node && node scripts/smoke-ipc.mjs",
    "smoke:ipc:electron": "set ELECTRON_RUN_AS_NODE=&& npm run rebuild:electron && electron . --smoke-ipc",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run rebuild:node && vitest",
    "test:unit": "npm run rebuild:node && vitest run --config vitest.config.ts tests/unit",
    "test:integration": "npm run rebuild:node && vitest run --config vitest.config.ts tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:functional-buttons": "playwright test tests/e2e/ui.button-functional.e2e.ts --project=chromium",
    "test:e2e:regression-matrix": "playwright test tests/e2e/ui.regression-matrix.e2e.ts --project=chromium",
    "test:e2e:regression-ui": "playwright test tests/e2e/ui.full-body-style.e2e.ts tests/e2e/ui.visual-regression.e2e.ts --project=chromium",
    "test:e2e:visual:update": "playwright test tests/e2e/ui.visual-regression.e2e.ts --project=chromium --update-snapshots",
    "test:e2e:visual": "playwright test tests/e2e/ui.visual-regression.e2e.ts --project=chromium",
    "test:e2e:desktop": "npm run test:e2e:regression-matrix && npm run test:e2e:regression-ui && npm run test:e2e:functional-buttons",
    "test:coverage": "npm run rebuild:node && vitest run --coverage",
    "test:watch": "npm run rebuild:node && vitest --watch",
    "test:ui": "npm run rebuild:node && vitest --ui",
    "test:performance": "npm run rebuild:node && vitest run --config vitest.config.ts tests/non-functional --testNamePattern='Performance'",
    "test:security": "npm run rebuild:node && vitest run --config vitest.config.ts tests/non-functional --testNamePattern='Security'",
    "test:a11y": "npm run rebuild:node && vitest run --config vitest.config.ts tests/non-functional --testNamePattern='Accessibility'",
    "test:all": "npm run rebuild:node && vitest run --coverage && playwright test",
    "db:drizzle:generate": "drizzle-kit generate",
    "db:drizzle:migrate": "drizzle-kit migrate",
    "db:drizzle:push": "drizzle-kit push"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.95.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "electron-store": "^11.0.2",
    "framer-motion": "^12.38.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.30.3",
    "scss": "^0.2.4",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron": "^40.8.3",
    "electron-builder": "^26.8.2",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "happy-dom": "^20.8.4",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.8",
    "sass": "^1.98.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.3.1"
  },
  "build": {
    "appId": "com.osama.finance",
    "productName": "Finance",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "react-dist/**",
      "src/electron/**",
      "src/services/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
